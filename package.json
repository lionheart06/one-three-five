{
  "name": "@lionheart06/one-three-five",
  "version": "1.0.0",
  "description": "Drop-in 1-3-5 todo planner for userscripts and web pages: drag tasks into 1, 3 and 5 buckets and they stay there.",
  "keywords": [
    "todo",
    "1-3-5",
    "tampermonkey",
    "userscript",
    "planner"
  ],
  "homepage": "https://github.com/lionheart06/one-three-five#readme",
  "bugs": {
    "url": "https://github.com/lionheart06/one-three-five/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lionheart06/one-three-five.git"
  },
  "license": "MIT",
  "author": "lionheart06",
  "type": "module",
  "main": "dist/one-three-five.esm.js",
  "module": "dist/one-three-five.esm.js",
  "types": "types/index.d.ts",
  "unpkg": "dist/one-three-five.min.js",
  "jsdelivr": "dist/one-three-five.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/one-three-five.esm.js",
      "default": "./dist/one-three-five.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "prepublishOnly": "npm test && npm run typecheck && npm run build && playwright test",
    "typecheck": "tsc -p test/types"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
